# Copy to .env and fill in. Never commit .env.
PAPER_TRADING=true

# Market data provider (use paper/sandbox or market-data-only keys)
DATA_PROVIDER=alpaca
DATA_API_KEY=your-key-here
DATA_API_SECRET=your-secret-here

# Broker/data base URL. MUST be a paper/sandbox URL (or the internal
# simulator) -- never a live/production trading endpoint. The app refuses to
# start if this matches an entry in LIVE_ENDPOINT_DENYLIST (backend/app/config.py).
DATA_BASE_URL=https://paper-api.alpaca.markets

# Simulation defaults
STARTING_CAPITAL=100000
SLIPPAGE_BPS=5
COMMISSION_PER_TRADE=1.00

DATABASE_URL=sqlite:///./paper.db

# Frontend: use the built-in mock API (default true) until the real client exists.
VITE_USE_MOCK_API=true
